# Croo Digital Experience — Backend Environment
# Copy this file to .env and fill in real values
# NEVER commit .env to git

# App
ENVIRONMENT=development
DEBUG=true
API_PORT=8000

# Database
DATABASE_URL=postgresql://croo:croo@localhost:5432/croo_digital_experience

# JWT — REQUIRED: generate with `openssl rand -hex 64`
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:4200","http://localhost:4511"]

# Rate limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Admin seed — REQUIRED
ADMIN_EMAIL=admin@croo.digital
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Croo

# Groq (LLM) — REQUIRED
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Serper.dev (Search) — REQUIRED for web search
SERPER_API_KEY=

# Webhooks — REQUIRED
WEBHOOK_API_KEY=
