# Croo Digital Experience — Backend
ENVIRONMENT=development
DEBUG=true
API_PORT=8000

# Database
DATABASE_URL=postgresql://croo:croo@localhost:5432/croo_digital_experience

# JWT
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-LONG-RANDOM-STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:4200"]

# Rate limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Admin seed
ADMIN_EMAIL=admin@croo.digital
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Croo

# Groq (LLM)
GROQ_API_KEY=your-groq-api-key-here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Serper.dev (Search)
SERPER_API_KEY=your-serper-api-key-here
