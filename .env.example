# Croo Digital Experience - local environment
# Copy to .env and fill local-only values. Do not use production secrets.

# Global environment
ENVIRONMENT=development
DEBUG=true
INGRESS_URL=http://localhost:4700
CORS_ORIGINS=["http://localhost:4200","http://localhost:4300","http://localhost:4700","http://127.0.0.1:4200","http://127.0.0.1:4300","http://127.0.0.1:4700"]
CDE_LOCAL_BOB_SETTINGS_CAPABILITIES=bob_settings.manage

# Database through PgBouncer
DB_HOST=pgbouncer
DB_PORT=5432
DB_USERNAME=croo
DB_PASSWORD=changeme
DB_DATABASE=croo_digital_experience
DATABASE_SSLMODE=disable
POSTGRES_PORT=55432
PGBOUNCER_HOST_PORT=56432
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20

# Redis / event bus
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6380
EVENT_BUS_BACKEND=redis

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
ALLOY_HTTP_PORT=12346
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318

# JWT / auth
JWT_SECRET_KEY=changeme-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
INTERNAL_SESSION_SECRET=changeme-use-openssl-rand-hex-64
INTERNAL_SESSION_KID=internal-session-dev
BOB_CLOUD_MODE=stub
BOB_CLOUD_API_URL=
BOB_CLOUD_STUB_API_URL=http://bob-cloud-stub-api:8010
BOB_CLOUD_TIMEOUT_SECONDS=10
CDE_LOCAL_AGENT_CONTROL_CAPABILITIES=agent_control.manage

# API ports
AUTH_B4F_API_PORT=8001
CRM_B4F_API_PORT=8002
AGENT_CONTROL_B4F_API_PORT=8008
COMMUNICATION_B4F_API_PORT=8004
PLATFORM_B4F_API_PORT=8005
KB_B4F_API_PORT=8006
BOB_CHAT_B4F_API_PORT=8007
BOB_CLOUD_STUB_API_PORT=8010
USER_BACKEND_API_PORT=9001
CONTACT_BACKEND_API_PORT=9002
ORG_BACKEND_API_PORT=9003
OPPORTUNITY_BACKEND_API_PORT=9004
ACTIVITY_BACKEND_API_PORT=9005
PRODUCT_BACKEND_API_PORT=9006
EMAIL_BACKEND_API_PORT=9007
AGENT_BACKEND_API_PORT=9008
WORKFLOW_BACKEND_API_PORT=9009
KB_BACKEND_API_PORT=9010
USAGE_BACKEND_API_PORT=9011
CONVERSATION_BACKEND_API_PORT=9012
CONVERSATION_BACKEND_API_URL=http://conversation-backend-api:9012
AGENT_RUNTIME_BACKEND_API_PORT=9013
AGENT_RUNTIME_BACKEND_API_URL=http://agent-runtime-backend-api:9013
AGENT_MEMORY_BACKEND_API_PORT=9014
AGENT_MEMORY_BACKEND_API_URL=http://agent-memory-backend-api:9014
FRONTEND_PORT=4700

# Vector index / Milvus
MILVUS_ENABLED=false
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_SECURE=false
MILVUS_CONNECT_TIMEOUT_SECONDS=5
MILVUS_DEFAULT_DIMENSION=1536
EMBEDDINGS_PROVIDER=disabled
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSION=1536

# Admin seed
ADMIN_EMAIL=admin@croo.digital
ADMIN_PASSWORD=changeme
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Croo

# LLM providers
AGENT_RUNTIME_PROVIDER=auto
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p7-code
FIREWORKS_TEMPERATURE=0.1
FIREWORKS_TOP_P=0.8
FIREWORKS_TIMEOUT_SECONDS=60

# Bob GitLab read connector (MCP gitlab-code)
CROO_GITLAB_API_URL=https://gitlab.tools.thesmartcrew.com/api/v4
CROO_GITLAB_TOKEN=
CROO_GITLAB_TIMEOUT_SECONDS=10
CROO_GITLAB_MAX_FILE_BYTES=16000

FACTORY_SUPABASE_DB_URL=
FACTORY_SUPABASE_CONNECT_TIMEOUT_SECONDS=10
GROQ_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=

# Enrichment / search
HUNTER_API_KEY=
SERPER_API_KEY=

# Webhooks
WEBHOOK_API_KEY=

# Microsoft 365
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_REDIRECT_URI=
MS365_WEBHOOK_HOST=

# Pipedream integration platform
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=development
PIPEDREAM_API_URL=https://api.pipedream.com/v1
PIPEDREAM_WEBHOOK_SECRET=
PIPEDREAM_SEND_EMAIL_ACTION_ID=
PIPEDREAM_REPLY_EMAIL_ACTION_ID=
PIPEDREAM_FORWARD_EMAIL_ACTION_ID=
PIPEDREAM_SYNC_EMAILS_ACTION_ID=
PUBLIC_API_URL=http://localhost:28004
