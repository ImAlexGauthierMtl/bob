# ═══════════════════════════════════════
# Croo Digital Experience — Environment
# Copy to .env and fill in values
# ═══════════════════════════════════════

# Environment
ENVIRONMENT=development
DEBUG=true

# Ingress / CORS (per-environment)
INGRESS_URL=http://localhost:4200
CORS_ORIGINS=["http://localhost:4200","http://localhost:4700"]

# Database
DB_USER=croo
DB_PASSWORD=changeme
DB_NAME=croo_digital_experience
DB_PORT=5432

# JWT
SECRET_KEY=changeme-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Redis / Event Bus
REDIS_PORT=6380
EVENT_BUS_BACKEND=redis

# Admin Seed
ADMIN_EMAIL=admin@croo.digital
ADMIN_PASSWORD=changeme
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Croo

# Observability (Alloy / Tempo)
OTLP_URL=

# LLM — Groq
GROQ_API_KEY=

# LLM — Alibaba Cloud (DashScope)
DASHSCOPE_API_KEY=

# LLM — OpenRouter
OPENROUTER_API_KEY=

# Enrichment — Hunter.io
HUNTER_API_KEY=

# Search — Serper.dev
SERPER_API_KEY=

# Webhooks
WEBHOOK_API_KEY=

# Microsoft 365 (MS Graph API)
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_REDIRECT_URI=
MS365_WEBHOOK_HOST=
