# ═══════════════════════════════════════
# Croo Digital Experience — Environment
# Copy to .env and fill in values
# ═══════════════════════════════════════

# Database
DB_USER=croo
DB_PASSWORD=changeme
DB_NAME=croo_digital_experience
DB_PORT=5432

# Environment
ENVIRONMENT=development
DEBUG=true

# API
API_PORT=4500

# JWT
SECRET_KEY=changeme-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:4200","http://localhost:4511","http://localhost:4700"]

# Rate Limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# Admin Seed
ADMIN_EMAIL=admin@croo.digital
ADMIN_PASSWORD=changeme
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Croo

# LLM — Groq
GROQ_API_KEY=

# LLM — Alibaba Cloud (DashScope)
DASHSCOPE_API_KEY=

# LLM — OpenRouter
OPENROUTER_API_KEY=

# Enrichment — Hunter.io
HUNTER_API_KEY=

# Search — Serper.dev
SERPER_API_KEY=

# Webhooks
WEBHOOK_API_KEY=

# Voice
RICK_REF_AUDIO_PATH=/app/app/voice/rick_ref.wav

# Microsoft 365 (MS Graph API)
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_REDIRECT_URI=
MS365_WEBHOOK_HOST=
